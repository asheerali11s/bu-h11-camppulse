# ==============================================================================
# CampPulse - Supabase Credentials Configuration
# ==============================================================================
# If left blank, CampPulse runs automatically with the high-fidelity
# built-in offline hybrid store and mock database seed.
#
# When connecting to your production Supabase project:
# 1. Create a Supabase project at https://supabase.com
# 2. Paste the SQL script from `supabase/schema.sql` into Supabase SQL Editor and run it.
# 3. Copy your project URL and Anon Public Key below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
